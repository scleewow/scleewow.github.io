{
  "area": "D",
  "title": "꾸미는 말",
  "intro": "문장의 뼈대는 그대로 두고 정보를 더하는 말이에요. \"무엇을 꾸미는가\"가 형용사와 부사를 가르는 기준이에요.",
  "concepts": [
    {
      "id": "D.adj",
      "name": "형용사",
      "stages": "E",
      "prerequisites": [
        "S.pos"
      ],
      "levels": {
        "E": {
          "why": "\"큰 개\", \"행복한 아이\"처럼 명사가 어떤지 자세히 말하려면 형용사가 필요해요.",
          "core": "형용사는 명사의 모양·색·기분·상태를 나타내요. 명사 앞에서 꾸미거나, be동사 뒤에서 주어를 설명해요.",
          "groups": [
            {
              "title": "명사 앞에서 꾸밈",
              "items": [
                "a big dog",
                "a happy girl",
                "red apples"
              ],
              "example": "형용사 + 명사"
            },
            {
              "title": "be동사 뒤에서 설명",
              "tone": "good",
              "items": [
                "The dog is big.",
                "She is happy.",
                "Apples are red."
              ],
              "example": "be + 형용사"
            }
          ],
          "diagram": "형용사는 두 자리에 와요. 명사 바로 앞, 또는 be동사 뒤예요.",
          "form": {
            "note": "형용사는 명사 앞에 오고, a/an이 있으면 a/an과 명사 사이에 와요.",
            "rows": [
              {
                "label": "명사 앞",
                "pattern": "(a/an) + 형용사 + 명사",
                "example": "a tall boy, an old car, cold water"
              },
              {
                "label": "be동사 뒤",
                "pattern": "주어 + be + 형용사",
                "example": "The boy is tall. / The water is cold."
              },
              {
                "label": "여러 개",
                "pattern": "형용사 + 형용사 + 명사",
                "example": "a nice big house"
              }
            ],
            "tip": "형용사에는 -s를 붙이지 않아요. red apples (O) / reds apples (X). a/an은 형용사의 첫소리에 맞춰요: an old car."
          },
          "uses": [
            {
              "name": "크기·모양",
              "meaning": "얼마나 큰지, 어떤 모양인지",
              "desc": "",
              "signals": [
                "big, small",
                "tall, short",
                "long, round"
              ],
              "examples": [
                {
                  "en": "a long bridge",
                  "ko": "긴 다리"
                },
                {
                  "en": "My brother is tall.",
                  "ko": "우리 형은 키가 커요."
                }
              ]
            },
            {
              "name": "색깔",
              "meaning": "무슨 색인지",
              "desc": "",
              "signals": [
                "red, blue, green",
                "black, white"
              ],
              "examples": [
                {
                  "en": "a yellow bag",
                  "ko": "노란 가방"
                },
                {
                  "en": "The sky is blue.",
                  "ko": "하늘이 파래요."
                }
              ]
            },
            {
              "name": "기분·성질",
              "meaning": "어떤 기분이나 성격인지",
              "desc": "",
              "signals": [
                "happy, sad, angry",
                "kind, funny, smart"
              ],
              "examples": [
                {
                  "en": "a kind teacher",
                  "ko": "친절한 선생님"
                },
                {
                  "en": "They are angry.",
                  "ko": "그들은 화가 났어요."
                }
              ]
            },
            {
              "name": "상태",
              "meaning": "어떤 상태인지",
              "desc": "",
              "signals": [
                "new, old",
                "hot, cold",
                "full, empty"
              ],
              "examples": [
                {
                  "en": "a new phone",
                  "ko": "새 휴대폰"
                },
                {
                  "en": "The soup is hot.",
                  "ko": "수프가 뜨거워요."
                }
              ]
            }
          ],
          "contrast": {
            "a": {
              "en": "a happy girl",
              "ko": "행복한 소녀 (명사 앞에서 꾸밈)"
            },
            "b": {
              "en": "The girl is happy.",
              "ko": "그 소녀는 행복하다 (be동사 뒤에서 설명)"
            },
            "point": "같은 형용사가 자리만 바꿔서 꾸미기도 하고 설명하기도 해요."
          },
          "notes": [
            {
              "title": "-thing 뒤에 오는 형용사",
              "text": "something, anything, nothing처럼 -thing으로 끝나는 말은 형용사가 뒤에서 꾸며요.",
              "examples": [
                {
                  "en": "I want something cold.",
                  "ko": "나는 차가운 것을 원해요."
                },
                {
                  "en": "There is nothing special.",
                  "ko": "특별한 것은 없어요."
                }
              ]
            }
          ],
          "summary_prompt": "형용사가 오는 두 자리를 예문과 함께 써 보세요."
        }
      },
      "misconceptions": [
        {
          "id": "D.adj.plural_s",
          "desc": "복수 명사 앞의 형용사에도 -s를 붙임",
          "wrong": "greens apples",
          "right": "green apples"
        },
        {
          "id": "D.adj.order",
          "desc": "형용사를 명사 뒤에 씀 (한국어식 순서 혼동)",
          "wrong": "an apple red",
          "right": "a red apple"
        },
        {
          "id": "D.adj.a_an",
          "desc": "형용사 첫소리를 무시하고 a/an을 고름",
          "wrong": "a old car",
          "right": "an old car"
        },
        {
          "id": "D.adj.thing_order",
          "desc": "-thing 앞에 형용사를 씀",
          "wrong": "cold something",
          "right": "something cold"
        }
      ]
    },
    {
      "id": "D.adv",
      "name": "부사",
      "stages": "E→M1",
      "prerequisites": [
        "D.adj"
      ],
      "levels": {
        "E": {
          "why": "\"빨리 달린다\", \"아주 덥다\"처럼 어떻게, 얼마나, 언제, 어디서 하는지 자세히 말하려면 부사가 필요해요.",
          "core": "부사는 동사·형용사·다른 부사·문장 전체를 꾸며요. \"어떻게, 얼마나, 언제, 어디서\"에 답해요. 명사는 꾸미지 않아요.",
          "groups": [
            {
              "title": "어떻게",
              "items": [
                "slowly",
                "quickly",
                "well",
                "hard"
              ]
            },
            {
              "title": "얼마나",
              "tone": "good",
              "items": [
                "very",
                "really",
                "too",
                "so"
              ]
            },
            {
              "title": "언제",
              "items": [
                "now",
                "today",
                "soon",
                "yesterday"
              ]
            },
            {
              "title": "어디서",
              "items": [
                "here",
                "there",
                "home",
                "outside"
              ]
            }
          ],
          "diagram": "부사는 \"어떻게, 얼마나, 언제, 어디서\"를 더해 주는 말이에요.",
          "form": {
            "note": "많은 부사는 형용사에 -ly를 붙여서 만들어요.",
            "rows": [
              {
                "label": "대부분",
                "pattern": "형용사 + ly",
                "example": "slow → slowly, quick → quickly, careful → carefully"
              },
              {
                "label": "자음 + y",
                "pattern": "y를 i로 바꾸고 + ly",
                "example": "happy → happily, easy → easily"
              },
              {
                "label": "-le",
                "pattern": "e를 빼고 + y",
                "example": "gentle → gently, simple → simply"
              },
              {
                "label": "모양이 같음",
                "pattern": "형용사 = 부사",
                "example": "fast, hard, early, late, high"
              },
              {
                "label": "특별한 것",
                "pattern": "good → well",
                "example": "She is a good singer. → She sings well."
              }
            ],
            "tip": "-ly로 끝나도 형용사인 말이 있어요. friendly(친절한), lovely(사랑스러운), lonely(외로운)"
          },
          "uses": [
            {
              "name": "동사를 꾸밈",
              "meaning": "어떻게 하는지",
              "desc": "",
              "signals": [
                "run fast",
                "speak slowly"
              ],
              "examples": [
                {
                  "en": "He runs fast.",
                  "ko": "그는 빨리 달려요."
                }
              ]
            },
            {
              "name": "형용사·부사를 꾸밈",
              "meaning": "얼마나 그런지",
              "desc": "",
              "signals": [
                "very hot",
                "really well"
              ],
              "examples": [
                {
                  "en": "It is very hot.",
                  "ko": "아주 더워요."
                },
                {
                  "en": "She speaks really well.",
                  "ko": "그녀는 정말 말을 잘해요."
                }
              ]
            },
            {
              "name": "문장 전체를 꾸밈",
              "meaning": "말하는 사람의 생각",
              "desc": "문장 맨 앞에 와서 문장 전체에 대한 느낌을 더해요.",
              "signals": [
                "luckily (다행히)",
                "sadly (안타깝게도)"
              ],
              "examples": [
                {
                  "en": "Luckily, I found my key.",
                  "ko": "다행히 열쇠를 찾았어요."
                }
              ]
            }
          ],
          "contrast": {
            "a": {
              "en": "He is a slow runner.",
              "ko": "slow: 명사 runner를 꾸미는 형용사"
            },
            "b": {
              "en": "He runs slowly.",
              "ko": "slowly: 동사 runs를 꾸미는 부사"
            },
            "point": "명사를 꾸미면 형용사, 동사를 꾸미면 부사예요."
          },
          "summary_prompt": "부사가 꾸미는 것과, 형용사로 부사를 만드는 방법을 써 보세요."
        },
        "M": {
          "core": "hard(열심히)와 hardly(거의 ~않다), late(늦게)와 lately(최근에)처럼 -ly가 붙으면 뜻이 완전히 달라지는 부사가 있어요.",
          "extra": "hardly는 \"거의 ~않다\"라는 부정의 뜻이라 not과 함께 쓰지 않아요. I can hardly hear you. (잘 안 들려요)",
          "contrast": {
            "a": {
              "en": "He studies hard.",
              "ko": "그는 열심히 공부한다"
            },
            "b": {
              "en": "He hardly studies.",
              "ko": "그는 거의 공부하지 않는다"
            },
            "point": "-ly 하나 차이로 뜻이 반대가 돼요."
          }
        }
      },
      "misconceptions": [
        {
          "id": "D.adv.ly_only",
          "desc": "-ly가 없으면 부사가 아니라고 생각하거나 fast에 -ly를 붙임",
          "wrong": "He runs fastly.",
          "right": "He runs fast."
        },
        {
          "id": "D.adv.friendly",
          "desc": "-ly로 끝나는 형용사(friendly 등)를 부사로 착각함",
          "wrong": "friendly = 친절하게 (부사)",
          "right": "friendly = 친절한 (형용사)"
        },
        {
          "id": "D.adv.spelling",
          "desc": "부사를 만드는 철자 규칙을 틀림",
          "wrong": "happyly / carefuly",
          "right": "happily / carefully"
        },
        {
          "id": "D.adv.good_well",
          "desc": "동사를 꾸밀 때 good을 씀",
          "wrong": "He plays the piano good.",
          "right": "He plays the piano well."
        },
        {
          "id": "D.adv.hardly",
          "desc": "hardly를 \"열심히\"로 착각함",
          "wrong": "He hardly studies. = 열심히 공부한다",
          "right": "= 거의 공부하지 않는다"
        }
      ]
    },
    {
      "id": "D.prep",
      "name": "전치사구",
      "stages": "E→M2",
      "prerequisites": [
        "S.sv"
      ],
      "levels": {
        "E": {
          "why": "\"상자 안에\", \"월요일에\", \"7시에\"처럼 장소와 시간을 말하려면 전치사가 필요해요. 한국어는 \"~에\" 하나로 말하지만 영어는 상황마다 다른 전치사를 써요.",
          "core": "전치사는 명사 앞에 와서 장소·시간·방향 등을 나타내요. \"전치사 + 명사\" 덩어리를 전치사구라고 해요.",
          "groups": [
            {
              "title": "시간",
              "items": [
                "at 7 o'clock",
                "on Monday",
                "in May"
              ],
              "example": "좁은 at → 넓은 in"
            },
            {
              "title": "장소",
              "tone": "good",
              "items": [
                "at the bus stop",
                "on the desk",
                "in the box"
              ],
              "example": "지점 at, 표면 on, 공간 in"
            }
          ],
          "diagram": "at은 한 점, on은 면이나 하루, in은 넓은 공간이나 기간이에요.",
          "form": {
            "note": "시간과 장소 모두 at, on, in을 범위에 따라 골라요.",
            "rows": [
              {
                "label": "시간 at",
                "pattern": "정확한 시각·때",
                "example": "at 7, at noon, at night"
              },
              {
                "label": "시간 on",
                "pattern": "요일·날짜·특정한 날",
                "example": "on Monday, on May 5th, on my birthday"
              },
              {
                "label": "시간 in",
                "pattern": "월·연도·계절·오전/오후",
                "example": "in May, in 2026, in summer, in the morning"
              },
              {
                "label": "장소 at",
                "pattern": "한 지점",
                "example": "at the bus stop, at school, at home"
              },
              {
                "label": "장소 on",
                "pattern": "표면 위 (붙어 있음)",
                "example": "on the desk, on the wall"
              },
              {
                "label": "장소 in",
                "pattern": "공간 안",
                "example": "in the box, in my room, in Seoul"
              }
            ],
            "tip": "시간도 장소도 \"좁은 것 at → 중간 on → 넓은 것 in\" 순서로 기억해요."
          },
          "uses": [
            {
              "name": "위치",
              "meaning": "어디에 있는지",
              "desc": "",
              "signals": [
                "under (아래에)",
                "behind (뒤에)",
                "in front of (앞에)",
                "next to (옆에)",
                "between A and B (A와 B 사이에)"
              ],
              "examples": [
                {
                  "en": "The cat is under the bed.",
                  "ko": "고양이가 침대 밑에 있어요."
                },
                {
                  "en": "The bank is between the school and the park.",
                  "ko": "은행은 학교와 공원 사이에 있어요."
                }
              ]
            },
            {
              "name": "방향",
              "meaning": "어디로, 어디에서",
              "desc": "",
              "signals": [
                "to (~로)",
                "from (~에서)",
                "into (~ 안으로)",
                "out of (~ 밖으로)"
              ],
              "examples": [
                {
                  "en": "I walked to the park.",
                  "ko": "공원까지 걸어갔어요."
                },
                {
                  "en": "He came out of the room.",
                  "ko": "그가 방에서 나왔어요."
                }
              ]
            },
            {
              "name": "그 밖의 뜻",
              "meaning": "함께, 위해, 관해",
              "desc": "",
              "signals": [
                "with (~와 함께)",
                "for (~를 위해)",
                "about (~에 관해)"
              ],
              "examples": [
                {
                  "en": "I went with my friend.",
                  "ko": "친구와 함께 갔어요."
                },
                {
                  "en": "This is a book about dinosaurs.",
                  "ko": "이건 공룡에 관한 책이에요."
                }
              ]
            }
          ],
          "contrast": {
            "a": {
              "en": "There is a cat on the box.",
              "ko": "고양이가 상자 위에 있다 (표면)"
            },
            "b": {
              "en": "There is a cat in the box.",
              "ko": "고양이가 상자 안에 있다 (공간)"
            },
            "point": "전치사 하나로 위치가 완전히 달라져요."
          },
          "summary_prompt": "시간과 장소의 at, on, in을 고르는 방법을 써 보세요."
        },
        "M": {
          "core": "전치사구는 명사 뒤에서 형용사처럼 꾸미기도 하고(the book on the desk), 동사를 부사처럼 꾸미기도 해요(I study in the library).",
          "extra": "전치사 뒤에는 명사, 목적격 대명사, 동명사(-ing)가 와요. with me, after school, before eating. 전치사구 안의 명사는 주어가 아니에요.",
          "contrast": {
            "a": {
              "en": "The book on the desk is mine.",
              "ko": "형용사 역할: 명사 book을 꾸밈"
            },
            "b": {
              "en": "I put the book on the desk.",
              "ko": "부사 역할: 동사 put을 꾸밈"
            },
            "point": "같은 전치사구라도 무엇을 꾸미는지에 따라 역할이 달라요."
          }
        }
      },
      "misconceptions": [
        {
          "id": "D.prep.time",
          "desc": "시간의 at, on, in을 혼동함",
          "wrong": "in Monday / at May",
          "right": "on Monday / in May"
        },
        {
          "id": "D.prep.place",
          "desc": "장소의 at, on, in을 혼동함",
          "wrong": "a picture in the wall",
          "right": "a picture on the wall"
        },
        {
          "id": "D.prep.subject_in_phrase",
          "desc": "전치사구 안의 명사를 주어로 착각해 동사를 맞춤",
          "wrong": "The books on the table is mine.",
          "right": "The books on the table are mine."
        }
      ]
    },
    {
      "id": "D.adj_vs_adv",
      "name": "형용사와 부사의 자리",
      "stages": "M1",
      "prerequisites": [
        "D.adv",
        "S.form1_2"
      ],
      "levels": {
        "M": {
          "why": "\"행복해 보인다\"처럼 한국어로는 부사처럼 들리는데 영어로는 형용사를 써야 하는 자리가 있어요. 해석이 아니라 \"무엇을 꾸미는지, 어떤 자리인지\"로 구분해야 해요.",
          "core": "명사를 꾸미거나 보어 자리(주어·목적어를 설명)에는 형용사, 동사·형용사·부사를 꾸미는 수식어 자리에는 부사를 써요.",
          "slots": [
            {
              "label": "보어 자리 → 형용사",
              "cells": [
                {
                  "role": "주어",
                  "text": "She"
                },
                {
                  "role": "동사",
                  "text": "looks"
                },
                {
                  "role": "보어",
                  "text": "happy"
                }
              ]
            },
            {
