{
  "area": "P",
  "title": "동사의 방향",
  "intro": "주어가 동작을 직접 하는지(능동), 동작을 받는지(수동)를 동사 모양으로 나타내요. 수동태는 \"be + p.p.\" 하나로 묶어요.",
  "concepts": [
    {
      "id": "P.concept",
      "name": "능동과 수동의 차이",
      "stages": "M2",
      "prerequisites": [
        "S.form3"
      ],
      "levels": {
        "M": {
          "why": "\"고양이가 쥐를 잡았다\"와 \"쥐가 고양이에게 잡혔다\"는 같은 일이지만 누구를 주인공(주어)으로 말하느냐가 달라요. 영어는 이 차이를 동사 모양으로 나타내요.",
          "core": "능동태는 주어가 동작을 하는 것, 수동태는 주어가 동작을 받는 것이에요. 능동태의 목적어가 수동태의 주어가 돼요.",
          "slots": [
            {
              "label": "능동",
              "cells": [
                {
                  "role": "주어 (하는 쪽)",
                  "text": "The cat"
                },
                {
                  "role": "동사",
                  "text": "caught"
                },
                {
                  "role": "목적어 (받는 쪽)",
                  "text": "the mouse"
                }
              ]
            },
            {
              "label": "수동",
              "cells": [
                {
                  "role": "주어 (받는 쪽)",
                  "text": "The mouse"
                },
                {
                  "role": "동사",
                  "text": "was caught"
                },
                {
                  "role": "수식어",
                  "text": "by the cat"
                }
              ]
            }
          ],
          "diagram": "능동태의 목적어(the mouse)가 수동태에서는 주어 자리로 옮겨 가요.",
          "form": {
            "note": "수동태는 동작을 \"받는\" 쪽이 더 중요하거나, 하는 사람을 모를 때 써요.",
            "rows": [
              {
                "label": "능동",
                "pattern": "주어(하는 쪽) + 동사 + 목적어",
                "example": "Tom broke the window."
              },
              {
                "label": "수동",
                "pattern": "주어(받는 쪽) + be + p.p. (+ by 행위자)",
                "example": "The window was broken by Tom."
              },
              {
                "label": "수동이 자연스러울 때",
                "pattern": "하는 사람을 모르거나 중요하지 않을 때",
                "example": "My bike was stolen. (누가 훔쳤는지 모름)"
              }
            ],
            "tip": "목적어가 없는 동사(happen, arrive, die 등)는 수동태로 만들 수 없어요."
          },
          "uses": [
            {
              "name": "누가 했는지 모를 때",
              "meaning": "~되었다",
              "desc": "하는 사람이 누구인지 모르거나 말할 필요가 없을 때 수동태를 써요.",
              "signals": [
                "by ~를 생략"
              ],
              "examples": [
                {
                  "en": "This house was built in 1990.",
                  "ko": "이 집은 1990년에 지어졌어요."
                },
                {
                  "en": "English is spoken in many countries.",
                  "ko": "영어는 많은 나라에서 쓰여요."
                }
              ]
            },
            {
              "name": "받는 쪽이 주인공일 때",
              "meaning": "~에 의해 …되었다",
              "desc": "이야기의 중심이 동작을 받는 쪽일 때 그것을 주어로 써요.",
              "signals": [
                "by + 행위자"
              ],
              "examples": [
                {
                  "en": "The Mona Lisa was painted by Leonardo da Vinci.",
                  "ko": "모나리자는 레오나르도 다빈치가 그렸어요."
                }
              ]
            }
          ],
          "contrast": {
            "a": {
              "en": "Many people love this song.",
              "ko": "능동: 사람들이 사랑한다"
            },
            "b": {
              "en": "This song is loved by many people.",
              "ko": "수동: 이 노래가 사랑받는다"
            },
            "point": "같은 사실이지만 주인공(주어)이 다르고, 동사 모양이 be + p.p.로 바뀌어요."
          },
          "summary_prompt": "능동태와 수동태의 차이를 \"주어가 하는가, 받는가\"로 설명해 보세요."
        }
      },
      "misconceptions": [
        {
          "id": "P.concept.who_does",
          "desc": "수동태 문장의 주어가 동작을 한다고 해석함",
          "wrong": "The mouse was caught by the cat. = 쥐가 고양이를 잡았다",
          "right": "= 쥐가 고양이에게 잡혔다"
        },
        {
          "id": "P.concept.intransitive",
          "desc": "목적어가 없는 동사를 수동태로 만듦",
          "wrong": "The accident was happened.",
          "right": "The accident happened."
        },
        {
          "id": "P.concept.object_switch",
          "desc": "능동태를 수동태로 바꿀 때 주어 자리에 원래 주어를 그대로 둠",
          "wrong": "Tom broke the window. → Tom was broken by the window.",
          "right": "The window was broken by Tom."
        }
      ]
    },
    {
      "id": "P.basic",
      "name": "수동태 기본형 (be + p.p.)",
      "stages": "M2",
      "prerequisites": [
        "P.concept",
        "T.pp_form"
      ],
      "levels": {
        "M": {
          "why": "수동태를 만들려면 be동사와 과거분사(p.p.)를 정확히 함께 써야 해요. 둘 중 하나만 쓰면 틀린 문장이 돼요.",
          "core": "수동태는 \"be + p.p.\"예요. be동사는 주어와 시제에 맞추고, p.p.는 그대로 둬요.",
          "slots": [
            {
              "label": "현재",
              "cells": [
                {
                  "role": "주어",
                  "text": "The room"
                },
                {
                  "role": "동사 (be + p.p.)",
                  "text": "is cleaned"
                },
                {
                  "role": "수식어",
                  "text": "every day"
                }
              ]
            },
            {
              "label": "과거",
              "cells": [
                {
                  "role": "주어",
                  "text": "These cookies"
                },
                {
                  "role": "동사 (be + p.p.)",
                  "text": "were made"
                },
                {
                  "role": "수식어",
                  "text": "by my mom"
                }
              ]
            }
          ],
          "diagram": "be동사가 시제와 주어를, p.p.가 \"받는다\"는 뜻을 맡아요.",
          "form": {
            "note": "be동사는 주어의 수와 시제에 맞춰 am·is·are·was·were로 바뀌어요.",
            "rows": [
              {
                "label": "현재",
                "pattern": "am / is / are + p.p.",
                "example": "The room is cleaned every day."
              },
              {
                "label": "과거",
                "pattern": "was / were + p.p.",
                "example": "The cookies were made by Mom."
              },
              {
                "label": "부정",
                "pattern": "be + not + p.p.",
                "example": "The door wasn't locked."
              },
              {
                "label": "의문",
                "pattern": "Be + 주어 + p.p. ~?",
                "example": "Was the door locked?"
              },
              {
                "label": "불규칙 p.p.",
                "pattern": "write-written, speak-spoken, build-built",
                "example": "The book was written in 2010."
              }
            ],
            "tip": "be동사를 빼먹거나(The room cleaned every day.) 동사원형을 쓰면(is clean) 틀려요."
          },
          "contrast": {
            "a": {
              "en": "The letter was written.",
              "ko": "편지가 쓰였다 (be + p.p., 수동)"
            },
            "b": {
              "en": "She wrote the letter.",
              "ko": "그녀가 편지를 썼다 (능동 과거)"
            },
            "point": "수동태에는 반드시 be동사와 p.p.가 함께 있어요."
          },
          "summary_prompt": "수동태의 모양과, 부정문·의문문 만드는 법을 써 보세요."
        }
      },
      "misconceptions": [
        {
          "id": "P.basic.no_be",
          "desc": "수동태에서 be동사를 빼먹음",
          "wrong": "The room cleaned every day.",
          "right": "The room is cleaned every day."
        },
        {
          "id": "P.basic.base_form",
          "desc": "be 뒤에 p.p. 대신 동사원형이나 과거형을 씀",
          "wrong": "The book was write. / was wrote",
          "right": "The book was written."
        },
        {
          "id": "P.basic.be_agree",
          "desc": "be동사를 주어의 수나 시제에 맞추지 않음",
          "wrong": "The cookies was made yesterday.",
          "right": "The cookies were made yesterday."
        },
        {
          "id": "P.basic.do_question",
          "desc": "수동태 의문문에 do·did를 씀",
          "wrong": "Did the door locked?",
          "right": "Was the door locked?"
        }
      ]
    },
    {
      "id": "P.tense",
      "name": "수동태의 시제·조동사",
      "stages": "M3",
      "prerequisites": [
        "P.basic",
        "T.perfect",
        "A.modal_basic"
      ],
      "levels": {
        "M": {
          "why": "\"고쳐질 것이다\", \"고쳐지고 있다\", \"이미 고쳐졌다\", \"고쳐져야 한다\"처럼 수동태도 시제와 조동사와 함께 써요.",
          "core": "시제와 조동사는 be동사에 붙이고, p.p.는 그대로 둬요. 미래 will be p.p., 진행 be being p.p., 완료 have been p.p., 조동사 can be p.p.예요.",
          "groups": [
            {
              "title": "미래·조동사",
              "items": [
                "will be + p.p.",
                "can / must / should be + p.p."
              ],
              "example": "be는 원형"
            },
            {
              "title": "진행",
              "items": [
                "am / is / are / was / were + being + p.p."
              ],
              "example": "being"
            },
            {
              "title": "완료",
              "tone": "good",
              "items": [
                "have / has / had + been + p.p."
              ],
              "example": "been"
            }
          ],
          "diagram": "be가 놓인 자리에 따라 be, being, been으로 모양만 바뀌고 p.p.는 그대로예요.",
          "form": {
            "note": "능동형의 시제 틀 안에 be를 넣고, 그 be 뒤에 p.p.를 붙인다고 생각하면 쉬워요.",
            "rows": [
              {
                "label": "미래",
                "pattern": "will be + p.p.",
                "example": "The bridge will be finished next year."
              },
              {
                "label": "진행",
                "pattern": "be + being + p.p.",
                "example": "The road is being repaired now."
              },
              {
                "label": "현재완료",
                "pattern": "have/has + been + p.p.",
                "example": "The work has been done."
              },
              {
                "label": "조동사",
                "pattern": "조동사 + be + p.p.",
                "example": "This rule must be followed."
              },
              {
                "label": "부정",
                "pattern": "첫 번째 조동사 뒤에 not",
                "example": "It can't be fixed. / It hasn't been sent yet."
              }
            ],
            "tip": "being은 진행, been은 완료예요. 헷갈리면 앞 단어를 보세요. is 뒤 → being, has 뒤 → been."
          },
          "contrast": {
            "a": {
              "en": "The road is being repaired.",
              "ko": "도로가 지금 수리되고 있다 (진행)"
            },
            "b": {
              "en": "The road has been repaired.",
              "ko": "도로가 (이미) 수리되었다 (완료)"
            },
            "point": "be동사 뒤에는 being, have 뒤에는 been이에요."
          },
          "summary_prompt": "수동태의 미래, 진행, 완료, 조동사 모양을 한 문장씩 써 보세요."
        }
      },
      "misconceptions": [
        {
          "id": "P.tense.modal_be",
          "desc": "조동사·will 뒤에 be를 빼거나 is를 씀",
          "wrong": "It will finished. / It can is fixed.",
          "right": "It will be finished. / It can be fixed."
        },
        {
          "id": "P.tense.being_been",
          "desc": "진행의 being과 완료의 been을 혼동함",
          "wrong": "The road is been repaired. / It has being done.",
          "right": "The road is being repaired. / It has been done."
        },
        {
          "id": "P.tense.no_pp",
          "desc": "시제 표시 뒤에 p.p. 대신 원형을 씀",
          "wrong": "It has been do.",
          "right": "It has been done."
        }
      ]
    },
    {
      "id": "P.by",
      "name": "by + 행위자와 관용 전치사",
      "stages": "M3",
      "prerequisites": [
        "P.basic"
      ],
      "levels": {
        "M": {
          "why": "수동태에서 \"누가 했는지\"는 by로 나타내지만, 어떤 표현은 by 대신 with, in, of 같은 다른 전치사와 짝을 이뤄요. 이런 짝은 덩어리로 외워 두면 편해요.",
          "core": "동작을 한 쪽은 \"by + 행위자\"로 나타내요. 하는 사람이 일반 사람이거나 모를 때는 생략해요. be interested in, be filled with처럼 by 대신 다른 전치사를 쓰는 표현도 있어요.",
          "groups": [
            {
              "title": "by + 행위자",
              "items": [
                "written by Kim",
                "painted by Picasso"
              ],
              "example": "누가 했는지"
            },
            {
              "title": "by를 생략",
              "items": [
                "English is spoken in Canada. (by people)",
                "My bag was stolen. (by someone)"
              ],
              "example": "일반 사람·모르는 사람"
            },
            {
              "title": "다른 전치사",
              "tone": "good",
              "items": [
                "be interested in",
                "be filled with",
                "be known to / for",
                "be made of / from"
              ],
              "example": "덩어리로 외우기"
            }
          ],
          "diagram": "\"누가\"가 중요하면 by를 쓰고, 정해진 짝이 있는 표현은 그 전치사를 써요.",
          "form": {
            "note": "아래 표현은 by 대신 정해진 전치사를 써요.",
            "rows": [
              {
                "label": "be interested in",
                "pattern": "~에 관심이 있다",
                "example": "I am interested in science."
              },
              {
                "label": "be filled with",
                "pattern": "~로 가득 차 있다",
                "example": "The box is filled with toys."
              },
              {
                "label": "be covered with",
                "pattern": "~로 덮여 있다",
                "example": "The mountain is covered with snow."
              },
              {
                "label": "be known to / for",
                "pattern": "~에게 알려져 있다 / ~로 유명하다",
                "example": "He is known to everyone. / Jeju is known for its beaches."
              },
              {
                "label": "be made of / from",
                "pattern": "~로 만들어지다 (재료가 보임 / 재료가 변함)",
                "example": "The desk is made of wood. / Cheese is made from milk."
              },
              {
                "label": "be satisfied with",
                "pattern": "~에 만족하다",
                "example": "She is satisfied with the result."
              }
            ],
            "tip": "made of는 재료가 그대로 보일 때(나무 책상), made from은 재료가 변해서 안 보일 때(우유 → 치즈)예요."
          },
          "contrast": {
            "a": {
              "en": "The desk is made of wood.",
              "ko": "책상은 나무로 만들어졌다 (나무가 그대로 보임)"
            },
            "b": {
              "en": "Cheese is made from milk.",
              "ko": "치즈는 우유로 만들어진다 (우유의 모습이 변함)"
            },
            "point": "재료가 보이면 of, 성질이 바뀌어 안 보이면 from이에요."
          },
          "summary_prompt": "by를 생략하는 경우와, by 대신 다른 전치사를 쓰는 표현 3개를 써 보세요."
        }
      },
      "misconceptions": [
        {
          "id": "P.by.always_by",
          "desc": "정해진 짝이 있는 표현에도 by를 씀",
          "wrong": "I am interested by music. / filled by water",
          "right": "I am interested in music. / filled with water"
        },
        {
          "id": "P.by.of_from",
          "desc": "made of와 made from을 혼동함",
          "wrong": "Cheese is made of milk.",
          "right": "Cheese is made from milk."
        },
        {
          "id": "P.by.keep_people",
          "desc": "일반 사람(by people, by them)을 굳이 남김",
          "wrong": "English is spoken by people in Canada.",
          "right": "English is spoken in Canada."
        }
      ]
    },
    {
      "id": "P.emotion",
      "name": "감정동사: -ing vs -ed",
      "stages": "M3",
      "prerequisites": [
        "P.basic",
        "V.participle"
      ],
      "levels": {
        "M": {
          "why": "영어의 감정동사는 \"~하게 만들다\"라는 뜻이에요. 그래서 \"지루한 영화\"와 \"지루해하는 나\"를 다른 모양으로 써요. 한국어와 달라서 자주 틀려요.",
          "core": "bore는 \"지루하게 만들다\"예요. 감정을 일으키는 쪽은 -ing(boring), 감정을 느끼는 쪽은 -ed(bored)예요.",
          "slots": [
            {
              "label": "일으키는 쪽",
              "cells": [
                {
                  "role": "주어",
                  "text": "The movie"
                },
                {
                  "role": "동사",
                  "text": "was"
                },
                {
                  "role": "보어 (-ing)",
                  "text": "boring"
                }
              ]
            },
            {
              "label": "느끼는 쪽",
              "cells": [
                {
                  "role": "주어",
                  "text": "I"
                },
                {
                  "role": "동사",
                  "text": "was"
                },
                {
                  "role": "보어 (-ed)",
                  "text": "bored"
                }
              ]
            }
          ],
          "diagram": "영화가 지루함을 주고(boring), 나는 지루함을 받아요(bored). 받는 쪽이라 수동의 p.p. 모양이에요.",
          "form": {
            "note": "감정을 \"받아서 느끼는\" 사람은 대부분 -ed예요.",
            "rows": [
              {
                "label": "bore",
                "pattern": "boring (지루한) / bored (지루해하는)",
                "example": "The class was boring. I was bored."
              },
              {
                "label": "interest",
                "pattern": "interesting (흥미로운) / interested (관심 있는)",
                "example": "The book is interesting. I'm interested in it."
              },
              {
                "label": "excite",
                "pattern": "exciting (신나는) / excited (신이 난)",
                "example": "The game was exciting. We were excited."
              },
              {
                "label": "surprise",
                "pattern": "surprising (놀라운) / surprised (놀란)",
                "example": "The news was surprising. She was surprised."
              },
              {
                "label": "tire",
                "pattern": "tiring (피곤하게 하는) / tired (피곤한)",
                "example": "It was a tiring day. I'm tired."
              },
              {
                "label": "명사 앞",
